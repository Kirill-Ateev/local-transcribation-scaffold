# Токен доступа (обязательно). Сгенерировать: openssl rand -hex 32
TRANSCRIBE_TOKEN=

# Резидентная модель (единственная): CT2-конверсия MediaTek Breeze-ASR-25,
# fine-tune Whisper large-v2 — оптимизация под традиционный китайский (Тайвань)
# и английский, включая их смешение в одной фразе. Загружается из HuggingFace
# (~3.1 ГБ fp16) в кэш; предзагрузка: server/scripts/download_model.py
WHISPER_MODEL=SoybeanMilk/faster-whisper-Breeze-ASR-25

# Устройство и точность: auto | cuda | cpu ; auto | int8 | int8_float16 | float16
# В контейнере рецепта (GPU) переопределяется compose'ом на cuda/float16.
DEVICE=auto
COMPUTE_TYPE=auto

# Слушающий адрес. В проде указать IP локального интерфейса Spark (см. deploy/README.md)
HOST=0.0.0.0
PORT=8337

# Язык по умолчанию: auto — автораспознавание на каждый запрос (можно переопределить
# в запросе параметром language: zh, en, ru, ...)
# Breeze-ASR-25 сильнее всего на zh (традиционный) и en; на коротких клипах
# авто-детект может ошибаться — тогда фиксируйте язык на стороне клиента.
DEFAULT_LANGUAGE=auto

# Лимит размера загружаемого файла, МБ
MAX_UPLOAD_MB=512

# Глоссарий терминов для initial_prompt (опционально, проверяется eval-набором)
INITIAL_PROMPT=
