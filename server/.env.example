# Токен доступа (обязательно). Сгенерировать: openssl rand -hex 32
TRANSCRIBE_TOKEN=

# Резидентная модель (единственная). По умолчанию large-v3.
WHISPER_MODEL=large-v3

# Устройство и точность: auto | cuda | cpu ; auto | int8 | int8_float16 | float16
DEVICE=auto
COMPUTE_TYPE=auto

# Слушающий адрес. В проде указать IP локального интерфейса Spark (см. deploy/README.md)
HOST=0.0.0.0
PORT=8337

# Лимит размера загружаемого файла, МБ
MAX_UPLOAD_MB=512

# Язык по умолчанию
DEFAULT_LANGUAGE=ru

# Глоссарий терминов для initial_prompt (опционально, проверяется eval-набором)
INITIAL_PROMPT=
